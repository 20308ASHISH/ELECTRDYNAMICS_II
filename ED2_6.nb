Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "m", ",", "k", ",", "T", ",", "h", ",", "v", ",", "vmin", ",", "nu"}], 
   "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vmin", "=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "h", " ", "nu"}], ")"}], "/", "m"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numerator", "=", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "^", "3"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"m", " ", 
            RowBox[{"v", "^", "2"}]}], ")"}]}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "k", " ", "T"}], ")"}]}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"0.3", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"m", " ", 
             RowBox[{"v", "^", "2"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"k", " ", "T"}], ")"}]}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", "vmin", ",", "Infinity"}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m", ">", "0"}], ",", 
         RowBox[{"k", ">", "0"}], ",", 
         RowBox[{"T", ">", "0"}], ",", 
         RowBox[{"h", ">", "0"}], ",", 
         RowBox[{"nu", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"denominator", "=", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "^", "4"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"m", " ", 
            RowBox[{"v", "^", "2"}]}], ")"}]}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "k", " ", "T"}], ")"}]}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"0.3", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"m", " ", 
             RowBox[{"v", "^", "2"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"k", " ", "T"}], ")"}]}]}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", "0", ",", "Infinity"}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m", ">", "0"}], ",", 
         RowBox[{"k", ">", "0"}], ",", 
         RowBox[{"T", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ratio", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"numerator", "/", "denominator"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"m", ">", "0"}], ",", 
        RowBox[{"k", ">", "0"}], ",", 
        RowBox[{"T", ">", "0"}], ",", 
        RowBox[{"h", ">", "0"}], ",", 
        RowBox[{"nu", ">", "0"}]}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]",
   "\n"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.971650507210787*^9, 3.971650527414312*^9}, 
   3.971650575915674*^9, {3.971650943570601*^9, 3.971650968448188*^9}, {
   3.97165104962354*^9, 3.971651053235188*^9}, {3.971651104159783*^9, 
   3.971651124934737*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"8ad752c4-4d92-43c6-936c-71c3189be699"],

Cell[BoxData[
 FractionBox[
  RowBox[{"0.10638460810704872`", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"h", " ", "nu"}], 
      RowBox[{"k", " ", "T"}]]}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"1.2`", " ", 
      SuperscriptBox["h", "2"], " ", 
      SuperscriptBox["nu", "2"]}], "+", 
     RowBox[{"4.4`", " ", "h", " ", "k", " ", "nu", " ", "T"}], "+", 
     RowBox[{"4.4`", " ", 
      SuperscriptBox["k", "2"], " ", 
      SuperscriptBox["T", "2"]}]}], ")"}]}], 
  RowBox[{
   SuperscriptBox["m", "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"k", " ", "T"}], "m"], ")"}], 
    RowBox[{"5", "/", "2"}]]}]]], "Output",
 CellChangeTimes->{
  3.971650511172303*^9, 3.971650584994873*^9, 3.9716509757742653`*^9, {
   3.971651112830332*^9, 3.971651130190282*^9}},
 CellLabel->"Out[76]=",ExpressionUUID->"aacfbd30-5064-4861-9f2b-24e66c4f4e1e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "constants"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"h", "=", 
     RowBox[{"6.626", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "34"}]}]}]}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Planck", " ", "constant", " ", "in", " ", "J", "*", "s"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"k", "=", 
     RowBox[{"1.381", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "23"}]}]}]}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Boltzmann", " ", "constant", " ", "in", " ", 
     RowBox[{"J", "/", "K"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"9.109", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "31"}]}]}]}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"Electron", " ", "mass", " ", "in", " ", "kg"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "general", " ", "function", " ", "for", " ", 
     RowBox[{"P", "[", 
      RowBox[{"nu", ",", "T"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P", "[", 
     RowBox[{"nu_", ",", "T_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0.106385", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"h", "*", "nu"}], ")"}]}], "/", 
         RowBox[{"(", 
          RowBox[{"k", "*", "T"}], ")"}]}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1.2", "*", 
          RowBox[{"h", "^", "2"}], "*", 
          RowBox[{"nu", "^", "2"}]}], "+", 
         RowBox[{"4.4", "*", "h", "*", "k", "*", "nu", "*", "T"}], "+", 
         RowBox[{"4.4", "*", 
          RowBox[{"k", "^", "2"}], "*", 
          RowBox[{"T", "^", "2"}]}]}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"m", "^", "2"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "*", "T"}], ")"}], "/", "m"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"5", "/", "2"}], ")"}]}]}], ")"}]}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "for", " ", "both", " ", "temperatures"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"nu", ",", "300"}], "]"}], ",", 
       RowBox[{"P", "[", 
        RowBox[{"nu", ",", 
         RowBox[{"10", "^", "6"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"nu", ",", 
       RowBox[{"10", "^", "10"}], ",", 
       RowBox[{"10", "^", "18"}]}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Blue"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Red"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Frequency \[Nu] (Hz)\>\"", ",", 
        "\"\<P(\[Nu]) (arbitrary units)\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Bremsstrahlung Spectrum for T = 300 K and T = 10^6 K\>\""}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"ScalingFunctions", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Log10\>\"", ",", "\"\<Log10\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<T = 300 K\>\"", ",", "\"\<T = 10^6 K\>\""}], "}"}]}]}], 
    "]"}], "\n"}]}]], "Input",
