Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"V", "=", "1"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "You", " ", "can", " ", "change", " ", "this", " ", "to", " ", "your", " ",
     "desired", " ", "amplitude"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "x_", "]"}], ":=", 
   RowBox[{"V", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"x", "/", "100"}], "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"0.6", "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"30", "*", "x"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "10000"}], "+", "900"}], ")"}], "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"30", "*", "x"}], "]"}]}]}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"y", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1000"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y(x)\>\""}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", 
   RowBox[{
   "PlotLabel", "->", 
    "\"\<y = V e^(x/100) [0.6 cos(30x) - (-1/10000 + 900) sin(30x)]\>\""}]}], 
  "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.971555000219274*^9, 3.971555000221307*^9}, {
  3.971555264177041*^9, 3.971555275659128*^9}},
